# Opsional: override URL API untuk frontend Reflex
PHISHGUARD_API_URL=http://localhost:8001/check

# Opsional: folder snapshot feed denylist (default data/feeds) dan batas umur (jam)
# PHISHGUARD_FEED_DIR=data/feeds
# PHISHGUARD_FEED_MAX_AGE_HOURS=24

# Opsional: Layer 0 Google Safe Browsing. Default mati (offline-first).
# Bila diaktifkan, URL yang diperiksa dikirim ke Google Safe Browsing.
# PHISHGUARD_USE_GOOGLE=false
# PHISHGUARD_GOOGLE_API_KEY=

# API Key dari Google Cloud Console
PHISHGUARD_GOOGLE_API_KEY=

# Toggle untuk mengaktifkan/mematikan pengecekan Google
# Set ke 'false' jika ingin testing offline atau quota habis
# PHISHGUARD_USE_GOOGLE=true
